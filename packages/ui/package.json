    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "next": "^16.3.4",
    "postcss": "^8.5.27",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.2",

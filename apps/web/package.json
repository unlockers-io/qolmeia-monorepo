{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "dev": "portless run --name qolmeia.web next dev",
    "start": "next start -p 3001",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flue/react": "2.2.2",
    "@flue/sdk": "2.2.2",
    "@repo/app-shell": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/config-next": "workspace:*",
    "@repo/identity": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/worker-api": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.4",
    "ai": "^7.0.181",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skullet": "^0.0.3",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",

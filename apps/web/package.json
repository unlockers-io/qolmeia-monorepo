    "@tanstack/react-query": "^5.103.1",
    "ai": "^7.0.105",
    "better-auth": "^1.7.5",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",

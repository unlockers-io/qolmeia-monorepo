{
  "name": "worker-bees",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --strict-vars=false",
    "clean": "rm -rf .turbo node_modules .wrangler dist",
    "db:seed": "tsx --env-file-if-exists=.dev.vars scripts/seed-dev.ts",
    "deploy": "vite build && wrangler deploy",
    "dev": "portless run --name qolmeia.agents --app-port 8787 vite dev",
    "lint": "oxlint src",
    "memory:reindex": "tsx --env-file-if-exists=.dev.vars scripts/reindex-memory.ts",
    "postinstall": "pnpm run cf-typegen",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.79",
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.1.1",
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/worker-api": "workspace:*",
    "agents": "^0.24.0",
    "ai": "^7.0.113",
    "hono": "^4.13.9",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@flue/vite": "2.1.1",
    "@repo/auth": "workspace:*",
    "@repo/portless-env": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.138.0",
    "zod-compiler": "^2.0.7"
  }
}

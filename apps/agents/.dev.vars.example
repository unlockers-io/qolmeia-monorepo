# Copy to .dev.vars (git-ignored) for local `wrangler dev`.
# Tests stub the model, so .dev.vars is only needed for manual chat testing.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Read only by the Node scripts (`pnpm db:seed`, `pnpm memory:reindex`). The
# Worker itself reaches Postgres through the HYPERDRIVE binding in wrangler.jsonc.
DATABASE_URL=postgresql://qolmeia:qolmeia123@127.0.0.1:5436/qolmeia

# Better Auth signs session cookies with it; at least 32 characters. Generate
# with `openssl rand -base64 48`. `pnpm db:seed` signs up the dev logins with it.
BETTER_AUTH_SECRET=

# Optional: comma-separated extra hostnames Better Auth accepts when deriving
# its base URL. `**.localhost`, `**.localhost:*`, `localhost:*` and
# `127.0.0.1:*` are built in, so local dev needs nothing here.
# AUTH_ALLOWED_HOSTS=
# App origins Better Auth trusts on top of the loopback ports. Unset, it trusts
# the web and backoffice portless URLs; `vite dev` fills it in a worktree.
# CORS_ORIGINS=https://qolmeia.web.localhost,https://qolmeia.backoffice.localhost
# Extra trusted origins. wrangler.jsonc sets the production app domains here.
# TRUSTED_ORIGINS=

# Resend API key for auth emails (magic link, verification, reset). Leave unset
# in dev: the Worker logs each link instead, and it opens as-is.
RESEND_API_KEY=
# Sends mail to the e2e Resend stub (tests/e2e/support/resend-stub.ts) instead of api.resend.com.
# RESEND_BASE_URL=http://127.0.0.1:3999
# Port the e2e Resend stub listens on; must match RESEND_BASE_URL.
# RESEND_STUB_PORT=3999

# Exa web-search API key (https://exa.ai) for the webSearch skill. Optional —
# leave unset and the skill returns a clear "indisponível" error.
EXA_API_KEY=

# Firecrawl for the fetchUrl skill (reads a webpage as markdown).
# Cloud (https://api.firecrawl.dev) needs FIRECRAWL_API_KEY (fc-...). To run
# keyless, self-host Firecrawl and set FIRECRAWL_BASE_URL to your instance.
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=http://localhost:3002

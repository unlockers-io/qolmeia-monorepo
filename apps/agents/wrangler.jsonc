{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-bees",
  // Pinned because this login can reach two accounts; without it wrangler and
  // the vitest remote proxy both fail with "More than one account available".
  "account_id": "e0d80dc903c7091fc398c6729971d0a7",
  // No "main": the flue() Vite plugin serves the Worker entry as the virtual
  // module `virtual:flue/worker`, and flueWorkerConfig() merges it plus the
  // per-agent Durable Object bindings into the Cloudflare plugin's config,
  // which `vite build` writes to dist/worker_bees/wrangler.json.
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Weekly proactive "suggest next work" sweep (Mondays 13:00 UTC ≈ 10:00 BRT).
  // → src/cloudflare.ts scheduled() → runProactiveSweep.
  "triggers": { "crons": ["0 13 * * 1"] },
  // One Durable Object class per exported agent function, named after it. The
  // bindings are generated at build time; migration history stays append-only.
  // Flue beta used persisted schema v5 while Flue 2 uses v8, so v3 drains the
  // reset-only beta classes and creates fresh V2 identities.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueCorrespondentAgent",
        "FluePlannerAgent",
        "FlueWorkerAgent",
        "FlueRegistry",
      ],
    },
    {
      "tag": "v2",
      // sqlite-backed, not "new_classes": KV-backed DOs require a paid plan
      // (API error 10097). TeamEvents keeps subscribers in memory and never
      // touches ctx.storage, so the backend choice is immaterial to it.
      "new_sqlite_classes": ["TeamEvents"],
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "FlueCorrespondentAgent",
        "FluePlannerAgent",
        "FlueWorkerAgent",
        "FlueRegistry",
      ],
      "new_sqlite_classes": ["FlueCorrespondentV2Agent", "FluePlannerV2Agent"],
    },
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "TeamEvents", "name": "TEAM_EVENTS" }],
  },
  "workflows": [
    {
      "binding": "WORKER_JOB",
      "class_name": "WorkerJobWorkflow",
      "name": "qolmeia-worker-job",
    },
  ],
  "vars": {
    // Unlockers account, which owns the qolmeia.com zone.
    "AI_GATEWAY_ACCOUNT_ID": "e0d80dc903c7091fc398c6729971d0a7",
    "AI_GATEWAY_NAME": "qolmeia",
    "CORRESPONDENT_MODEL": "anthropic/claude-sonnet-5.5",
    // Stable Nano Banana 2: image generation and multi-turn/reference editing.
    // Uses /chat/completions with modalities: ["image", "text"].
    "IMAGE_GEN_MODEL": "google/gemini-3.1-flash-image",
    // Public URL of this Worker, baked into every signed asset URL. For local
    // `vite dev` swap to http://127.0.0.1:8787 (IPv4, not localhost: vite binds
    // one address and vite.config.ts pins it there so the Next rewrites reach it).
    "WORKER_PUBLIC_URL": "https://agents.qolmeia.com",
    // Better Auth service (apps/api); the Worker validates sessions against it.
    // Local: http://localhost:4000.
    "AUTH_SERVICE_URL": "https://api.qolmeia.com",
    // Comma-separated client origins allowed to call the Worker; matched exactly,
    // no wildcards. Local: http://localhost:3000,http://localhost:3001.
    "CLIENT_ORIGINS": "https://app.qolmeia.com,https://admin.qolmeia.com",
  },
  // Postgres, the system of record (ADR 0010). Hyperdrive holds the origin
  // credentials and connects to Railway from Cloudflare's network, so workerd
  // never validates Railway's self-signed certificate. `vite dev` connects to
  // localConnectionString (the docker Postgres) instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ae9f33ab0aad4f829ae706cea2a03c10",
      "localConnectionString": "postgresql://qolmeia:qolmeia123@127.0.0.1:5436/qolmeia",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      // Miniflare emulates R2 locally; deploy creates the real bucket via
      // `wrangler r2 bucket create qolmeia-assets`.
      "bucket_name": "qolmeia-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // 30s session cache for validateSession; keeps the auth service off
      // the hot path of every backoffice render + every chat request.
      "id": "4de0e3d0d0364a058ac348a882d7ebb8",
    },
  ],
  "env": {
    "test": {
      "name": "worker-bees-test",
      "routes": [],
      "vars": {
        "AI_GATEWAY_ACCOUNT_ID": "test-account-id",
        "AI_GATEWAY_NAME": "test-gateway",
        "CORRESPONDENT_MODEL": "test/model",
        "IMAGE_GEN_MODEL": "test/image-model",
        "WORKER_PUBLIC_URL": "http://127.0.0.1:8787",
        "AUTH_SERVICE_URL": "http://127.0.0.1:4000",
        "CLIENT_ORIGINS": "http://localhost:3000,http://localhost:3001",
      },
      "durable_objects": {
        "bindings": [{ "class_name": "TeamEvents", "name": "TEAM_EVENTS" }],
      },
      "workflows": [
        {
          "binding": "WORKER_JOB",
          "class_name": "WorkerJobWorkflow",
          "name": "qolmeia-worker-job-test",
        },
      ],
      // vitest.config.ts points this at the checkout's own test database.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "test",
          "localConnectionString": "postgresql://qolmeia:qolmeia123@127.0.0.1:5436/qolmeia_test",
        },
      ],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "qolmeia-assets-test" }],
      "kv_namespaces": [{ "binding": "SESSIONS", "id": "test" }],
    },
  },
  "routes": [{ "pattern": "agents.qolmeia.com", "custom_domain": true }],
  // Workers AI and Vectorize have no local emulators. Vite and Vitest remove
  // these bindings from local runtimes while production builds keep them.
  "ai": { "binding": "AI" },
  // Backfill this model-specific index before deploying; see docs/model-upgrade.md.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "qolmeia-memory-qwen3" }],
}

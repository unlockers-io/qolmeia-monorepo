# The browser only talks to this app's origin: next.config.ts rewrites
# /api/auth/* to AUTH_SERVICE_INTERNAL_URL and /api/backoffice/* to
# AGENTS_INTERNAL_URL, so the session cookie is host-only on this app.
# `next build` bakes both into the rewrites, so set them before building
# (prod: https://api.qolmeia.com and https://agents.qolmeia.com).
# AGENTS_INTERNAL_URL=http://127.0.0.1:8787
# AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:4000

# Server-side Better Auth secret. MUST match apps/api/.env so the cookie
# issued by the auth service validates here. Generate with
# `openssl rand -base64 48`.
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-secret

# Postgres URL — used by the proxy.ts middleware's Better Auth getSession
# (validates the cookie locally without round-tripping to the auth service).
DATABASE_URL=postgresql://qolmeia:qolmeia123@localhost:5436/qolmeia
PGAPPNAME=qolmeia:local:backoffice

# Optional: used in metadataBase for OG/social previews.
# BACKOFFICE_URL=https://admin.qolmeia.com

# Public HTTPS URL of this app. Gates useSecureCookies in the proxy.ts Better
# Auth instance: unset, or not starting with https://, and getSession looks for
# the session cookie without the __Secure- prefix that the API issues over https.
# Local dev fills it from portless (next.config.ts).
# WEB_APP_URL=https://admin.qolmeia.com

# Must match apps/api. proxy.ts sends it with the client IP Vercel observed on
# /api/auth/* calls, so the api rate-limits anonymous requests per browser.
# Set it only on Vercel, which overwrites x-forwarded-for.
# TRUSTED_PROXY_SECRET=

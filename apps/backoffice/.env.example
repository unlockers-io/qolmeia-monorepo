# The browser only talks to this app's origin: next.config.ts rewrites
# /api/auth/* and /api/backoffice/* to the agents Worker at AGENTS_INTERNAL_URL,
# so the session cookie is host-only on this app. `next build` bakes it into the
# rewrites, so set it before building (prod: https://agents.qolmeia.com). Server
# components read the session through the same URL. Local dev fills it from
# portless.
# AGENTS_INTERNAL_URL=http://127.0.0.1:8787

# This app's public origin, for metadataBase (OG/social previews). Defaults to
# https://admin.qolmeia.com.
# BACKOFFICE_URL=https://admin.qolmeia.com

# Must match the Worker's TRUSTED_PROXY_SECRET. proxy.ts sends it with the client
# IP Vercel observed on /api/auth/* calls, so Better Auth rate-limits per browser.
# Set it only on Vercel, which overwrites x-forwarded-for.
# TRUSTED_PROXY_SECRET=

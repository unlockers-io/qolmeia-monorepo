{
  "version": 1,
  "profile": "saas",
  "mode": "affected",
  "check": {
    "env": {
      "DATABASE_URL": "postgresql://qolmeia:qolmeia@localhost:5432/qolmeia_test",
      "PGAPPNAME": "qolmeia:ci:test"
    },
    "services": {
      "postgres": {
        "image": "postgres:18-alpine",
        "env": {
          "POSTGRES_USER": "qolmeia",
          "POSTGRES_PASSWORD": "qolmeia",
          "POSTGRES_DB": "qolmeia_test"
        },
        "ports": ["5432:5432"],
        "options": "--health-cmd \"pg_isready -U qolmeia -d qolmeia_test\" --health-interval 10s --health-timeout 5s --health-retries 5"
      }
    },
    "setup": [
      {
        "name": "Generate the worker-bees binding types",
        "run": "pnpm --filter worker-bees cf-typegen"
      },
      { "run": "pnpm db:push" }
    ]
  }
}
